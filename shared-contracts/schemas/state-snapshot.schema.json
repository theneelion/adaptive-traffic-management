{
  "$id": "ServerStateSnapshot",
  "type": "object",
  "required": ["type", "payload", "ts"],
  "properties": {
    "type": { "const": "state" },
    "ts": { "type": "number" },
    "payload": {
      "type": "object",
      "required": ["tick", "vehicles", "signals", "pedestrians"],
      "properties": {
        "tick": { "type": "number" },
        "pedestrians": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "x", "y"],
            "properties": {
              "id": { "type": "string" },
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        },
        "vehicles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "x", "y", "heading", "speed", "controller"],
            "properties": {
              "id": { "type": "string" },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "heading": { "type": "number" },
              "speed": { "type": "number" },
              "controller": { "enum": ["idm", "user", "ev"] }
            }
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["intersectionId", "phase", "msRemainingMin"],
            "properties": {
              "intersectionId": { "type": "string" },
              "phase": { "type": "string" },
              "msRemainingMin": { "type": "number" },
              "light": { "enum": ["green", "yellow", "red"] }
            }
          }
        }
      }
    }
  }
}
